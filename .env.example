# Root private configuration. Never put keys into EXPO_PUBLIC_* variables.
CONVEX_CLOUD_URL=
CONVEX_ACTION_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
RESEND_API_KEY=
RESEND_FROM=
# Temporarily disabled at the learner's request; enable after sender is ready.
ACCOUNT_EMAIL_ENABLED=false
SITE_URL=
ANDROID_PACKAGE_ID=com.kiro.japanesestudy
# The Convex deployment needs its Auth signing keys and SITE_URL as well.

# Server-only AI configuration. Never copy these into native/public variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
CLOUDFLARE_GATEWAY_TOKEN=
CLOUDFLARE_WORKERS_AI_TOKEN=
# Enable only after confirming Workers Free; paid Workers usage is not authorized.
WORKERS_AI_FREE_ONLY_VERIFIED=false
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_CONVERSATION_PROVIDER=gemini
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# This route passed the live Cloudflare Gateway probe.
OPENROUTER_GATEWAY_PATH=/openrouter
QLOO_API_KEY=
QLOO_API_URL=
# Set only after inspecting the provisioned /v2/tags item schema.
QLOO_TAG_ID_FIELD=
# Enable requests only after live free-capacity checks. No paid fallback.
AI_FREE_ONLY=true
# Gemini is the sole paid exception after explicit approval and a total cap.
GEMINI_ALLOW_PAID=false
GEMINI_BUDGET_MICROUSD=0
